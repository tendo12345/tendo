{
  "name": "basis-mcp-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server exposing the current Basis-generated design system to AI coding agents.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --external:@modelcontextprotocol/sdk --external:zod",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  }
}
