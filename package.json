{
  "name": "design-system-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx scripts/generate.ts",
    "sweep": "tsx scripts/parity-sweep.ts",
    "data:check": "tsx scripts/strip-data-columns.ts --check",
    "data:strip": "tsx scripts/strip-data-columns.ts",
    "data:verify": "tsx scripts/verify-data-parity.ts",
    "build:sample": "tsx scripts/build-sample-system.ts",
    "mcp": "tsx mcp-server/src/index.ts",
    "mcp:build": "npm --prefix mcp-server run build",
    "build:coverage": "tsx scripts/build-coverage.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
